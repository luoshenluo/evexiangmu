{
  "name": "garden-game",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ -z \"$NOP_BUILD\" ]; then NOP_BUILD=1 npx @cloudflare/next-on-pages && rm -rf dist && cp -r .vercel/output/static dist; else next build; fi",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "npx @cloudflare/next-on-pages && npx wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.424.0",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "pg": "^8.22.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wrangler": "^4.118.0"
  }
}
